{
  "description": "agentic-engineering guardrails: block destructive commands, secret access and guardrail edits.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/hooks/policy.py\"",
            "timeout": 30,
            "statusMessage": "Checking agent policy"
          }
        ]
      }
    ]
  }
}
